# ════════════════════════════════════════════════════════════════════
#  BGMI Lookup Bot  —  environment variables
# ════════════════════════════════════════════════════════════════════

# ── Required on both Replit and Vercel ──────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OWNER_ID=your_telegram_numeric_user_id

# ── Required on Vercel (Upstash Redis — free tier is fine) ──────────
#
#  1. Sign up free at https://console.upstash.com/
#  2. Create a Redis database (pick the region nearest your Vercel region)
#  3. Open the database → REST API tab → copy the two values below
#
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ── Optional but strongly recommended ───────────────────────────────
#  Set to any random string.  Telegram will send this value in the
#  X-Telegram-Bot-Api-Secret-Token header on every update so that
#  random internet traffic is rejected by the webhook handler.
WEBHOOK_SECRET=change_me_to_a_random_string

# ── Not needed on Vercel (handled by api/webhook.py + setup_webhook.py)
# WEBHOOK_URL=https://your-project.vercel.app/api/webhook
